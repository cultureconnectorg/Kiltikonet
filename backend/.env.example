# ================================================================
# KILTIKONET — Backend .env.example
# Template à copier en .env et remplir avec les vraies valeurs.
# Ce fichier PEUT être commité — il ne contient aucune vraie clé.
# ================================================================

# CRITIQUE — L'application ne démarre pas sans ces variables
MONGO_URL=<your-mongodb-connection-string>
DB_NAME=<your-mongodb-database-name>
SESSION_SECRET=<generate-with: openssl rand -hex 64>
ENVIRONMENT=development

# CORS (séparer par virgule, pas d'espace)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# URLs
BASE_URL=http://localhost:8001
FRONTEND_URL=http://localhost:3000

# Stripe
STRIPE_API_KEY=<your-stripe-secret-key>
STRIPE_PUBLIC_KEY=<your-stripe-publishable-key>
STRIPE_WEBHOOK_SECRET=<your-stripe-webhook-secret>

# Cloudinary
CLOUDINARY_CLOUD_NAME=<your-cloudinary-cloud-name>
CLOUDINARY_API_KEY=<your-cloudinary-api-key>
CLOUDINARY_API_SECRET=<your-cloudinary-api-secret>

# Resend
RESEND_API_KEY=<your-resend-api-key>
SENDER_EMAIL=noreply@kiltikonet.fr

# OAuth
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>
GITHUB_CLIENT_ID=<your-github-oauth-app-client-id>
GITHUB_CLIENT_SECRET=<your-github-oauth-app-client-secret>
GITHUB_REDIRECT_URI=http://localhost:8001/api/auth/github/callback

# hCaptcha
HCAPTCHA_SECRET=<your-hcaptcha-secret-key>

# FREK
FREK_API_URL=<your-frek-api-url>
FREK_CLIENT_ID=<your-frek-client-id>
FREK_CLIENT_SECRET=<your-frek-client-secret>
FREK_ADMIN_KEY=<your-frek-admin-key>
FREK_FALLBACK_MODE=false

# Baserow
BASEROW_URL=<your-baserow-instance-url>
BASEROW_TOKEN=<your-baserow-api-token>
BASEROW_TABLE_ID=<your-baserow-table-id>
TABLE_BADGES=<your-baserow-badges-table-id>

# LLM / IA
ANTHROPIC_API_KEY=<your-anthropic-api-key>
OPENAI_API_KEY=<your-openai-api-key>
EMERGENT_LLM_KEY=<your-emergent-llm-key>
TAVILY_API_KEY=<your-tavily-api-key>

# AWS S3 (optionnel)
AWS_ACCESS_KEY_ID=<your-aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-aws-secret-access-key>
AWS_REGION=eu-west-3

# Push Notifications
VAPID_PUBLIC_KEY=<your-vapid-public-key>
VAPID_PRIVATE_KEY=<your-vapid-private-key>
VAPID_CLAIM_EMAIL=admin@kiltikonet.fr

# WebAuthn
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# Email alternatif
BREVO_SMTP_KEY=<your-brevo-smtp-key>
SES_FROM_EMAIL=<your-ses-verified-email>

# Admin / Sécurité
ADMIN_EMAIL=admin@kiltikonet.fr
EMERGENCY_SECRET=<generate-with: openssl rand -hex 32>

# Métier
JETON_VALEUR_EURO=1.50
JETON_RACHAT_EURO=0.75
